vendor/
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*

# Environment files
.env
.env.local
.env.production

# Version control
.git
.gitignore

# Development files
node_modules
tests
.vscode
.idea

# Documentation (opsional, bisa dihapus jika tidak diperlukan di production)
*.md
!README.md

# OS files
.DS_Store
Thumbs.db

# Laravel specific
bootstrap/cache/*

# Build script (needed for deployment)
!vercel-build.sh